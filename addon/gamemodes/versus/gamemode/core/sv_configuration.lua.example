-- The host that your MySQL database is located.
versus.config["MySQL Host"] = "localhost"

-- The username that you log into MySQL with.
versus.config["MySQL Username"] = "root"

-- The password that you log into MySQL with.
versus.config["MySQL Password"] = ""

-- The name of the database that we'll be using.
versus.config["MySQL Database"] = "versus"

-- The name of the table where the player data is stored.
versus.config["MySQL Player Table"] = "players"

-- The name of the table where sanctions are stored.
versus.config["MySQL Player Sanctions Table"] = "player_sanctions"

-- The name of the table where the organizations data are stored.
versus.config["MySQL Organization Table"] = "organizations"

-- The date format used when storing a timestamp
versus.config["MySQL Date Format"] = "%Y-%m-%d %X"

-- Webhook URL for Discord notifications. Set this to nil to disable.
versus.config["Discord Webhook"] = nil

-- Invite link shown to players in the "Join our Discord" welcome message. Set this to nil to disable the message.
versus.config["Discord Invite Link"] = nil

-- SteamID64s allowed to bypass the Endurance mode connect-window/matchmaking gate for testing,
-- as long as their name ends with "*" (e.g. "MyName*"). Keyed by SteamID64, e.g:
-- versus.config["Endurance Testing SteamIDs"] = { ["76561198000000000"] = true }
-- Leave empty on production servers.
versus.config["Endurance Testing SteamIDs"] = {}
