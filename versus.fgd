//================================================================//
//      Defines entities and available keyvalues for Versus:      //
//              https://github.com/luttje/gmod-versus             //
//================================================================//
@PointClass base(Targetname, Angles) studioprop("models/props_junk/PopCan01a.mdl") = versus_map_type :
    "Entity used to store the map type, which is used primarily for the Hideout maps, where combat is disabled and players can sell/trade items."
[
    maptype(choices) : "Map Type" : "" : "The type of the map. This is used to determine certain map-specific features and behaviors. For example, on Hideout maps, combat is disabled and players can sell/trade items." =
    [
        0 : "Combat"
        1 : "Hideout"
        2 : "Endurance"
    ]
]

@PointClass base(Targetname, Angles) studioprop("models/props_lab/eyescanner.mdl") = versus_housing_instance_switcher :
    "Let's players switch into a housing instance when used."
[
    instancetargetname(target_destination) : "Instance Target Name" : "" : "Where the player will be teleported to when using this entity. This should match the targetname of a versus_housing_instance_target entity."
    instancename(string) : "Instance Name" : "" : "Human-readable name for the instance. Like the room type or something, so players know the type of their room."
]

@PointClass base(Targetname, Angles) studioprop("models/editor/playerstart.mdl") = versus_housing_instance_target :
    "Target for housing instance switcher. This is where players will be teleported to when they use a versus_housing_instance_switcher that points to this entity."
[
    instanceid(string) : "Instance ID" : "" : "Unique identifier for the instance. Players in the same instance will be able to see and interact with each other. Set empty to leave instance and go to common area."
    pricescale(float) : "Price Scale" : "1" : "How expensive the room is. This is a scale, so we can easily adjust prices later by setting the base price for rooms and multiplying it by this scale."
]

@PointClass base(Targetname, Angles) studio() = versus_housing_instance_default_entity :
    "Designates the default spawn position for an entity that comes with the housing instance. Players can move this and it will save the new position. This is used for things like chests that come with the housing instance."
[
    instanceid(string) : "Instance ID" : "" : "Unique identifier for the instance this entity belongs to. This should match the instanceid of a versus_housing_instance_target entity."
    entityclass(string) : "Entity Class" : "" : "The class of the entity. This is used to determine what type of entity this is, so we can apply the correct behavior to it. For example, if it's a chest, we want to make it so players can open it and store items in it."
    model(studio) : "World Model" : "" : "The model of the entity. This is used to determine the appearance of the entity. For example, if it's a chest, we want it to look like a chest."
]

@PointClass base(Targetname, Angles) studioprop("models/versus/corkboard001.mdl") = versus_server_corkboard :
    "A corkboard that displays a list of combat servers that players can connect to. The list of servers is configured via the 'versus_combat_servers' ConVar, which should be a comma-separated list of server IPs and ports."
[
    boardtitle(string) : "Board Title" : "" : "The title displayed at the top of the corkboard."
]

@PointClass base(Targetname, Angles) studio("models/props/cs_office/offcorkboarda.mdl") = versus_leaderboard_corkboard :
    "A corkboard that displays the leaderboard. The leaderboard data is sent from the server and should include player names, ranks, money, XP, and levels."
[
    boardtitle(string) : "Board Title" : "" : "The title displayed at the top of the corkboard."
]

@PointClass base(Targetname, Angles) studio("models/props/cs_office/file_box.mdl") = versus_suggestion_box :
    "A suggestion box that players can interact with to submit feature and contract suggestions."
[
]

@PointClass base(Angles) studio("models/editor/playerstart.mdl") = versus_npc :
    "Entity that represents an NPC in the world"
[
    npcid(string) : "NPC UniqueID" : "" : "Unique ID of the NPC, used to setup appearance and interactions."
]

@PointClass base(Targetname, Angles) studio("models/editor/playerstart.mdl") = versus_npc_spawn_point :
    "Marks a position where the NPC director (or Endurance waves) may spawn enemies. Leave Arena ID empty for normal combat maps. Set Arena ID to the Spawn ID of a versus_squad_spawn to restrict this point to that Endurance arena only."
[
    arenaid(string) : "Arena ID (Endurance only)" : "" : "Spawn ID of the versus_squad_spawn arena this point belongs to. When set, this point is only used by the Endurance wave system for the named arena. Leave empty for normal (non-Endurance) NPC director use."
]

@PointClass base(Targetname) studio("models/editor/playerstart.mdl") = versus_radiation_info :
    "Marks the entire map as an irradiated zone. Place anywhere in the map. Its mere presence is enough — no radius or volume logic is needed. Players on this map will accumulate radiation over time and cannot accept contracts once they exceed the configured threshold."
[
]

@PointClass base(Targetname, Angles) studio("models/editor/playerstart.mdl") = versus_squad_spawn :
    "Marks a squad spawn position for Endurance maps. Place one per arena copy in the map. Each versus_squad_spawn represents a separate arena that a single squad can occupy at a time."
[
    spawnid(string) : "Spawn ID" : "" : "Unique identifier for this squad spawn within the map. Must be unique across all versus_squad_spawn entities on this map."
]

@PointClass base(Targetname, Angles) studio("models/editor/playerstart.mdl") = versus_spawn_point :
    "Marks a spawn point for players."
[
]

@PointClass base(Targetname, Angles) studioprop() = versus_objective_interaction :
    "An entity that players can interact with to complete an objective. The specific behavior of the interaction is determined by the contract, which uses tag to find relevant entities."
[
    tag(string) : "Interaction Tag" : "" : "A tag for the interaction. This is used by contracts to find relevant entities for objectives. For example, a contract might require the player to interact with an entity that has interactionname 'hack_computer', so it would look for versus_objective_interaction entities with that interactionname."
    model(studio) : "World Model" : "models/props_combine/breenconsole.mdl" : "The model of the entity. This is used to determine the appearance of the entity."
	modelscale(float) : "Model Scale" : : "A multiplier for the size of the model."

    // Commented as contracts will set these:
    // interactionname(string) : "Interaction Name" : "" : "A name to be displayed to players when they look at the entity. This should be a short, clear instruction like 'Hack Computer' or 'Search Body' or something like that."
    // interactiondescription(string) : "Interaction Description" : "" : "A description of the interaction, shown to players when they look at the entity. This should be a short instruction or hint about what the player needs to do to complete the interaction, like 'Hold E to hack the computer' or something like that."
    // interactiontime(float) : "Interaction Time" : "0" : "The time in seconds it takes to complete the interaction. If 0, the interaction is instant."
]
