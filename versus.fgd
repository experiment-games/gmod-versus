//================================================================//
//      Defines entities and available keyvalues for Versus:      //
//              https://github.com/luttje/gmod-versus             //
//================================================================//
@PointClass base(Targetname, Angles) studioprop("models/props_junk/PopCan01a.mdl") = versus_map_type :
    "Entity used to store the map type, which is used primarily for the Hideout maps, where combat is disabled and players can sell/trade items."
[
    maptype(choices) : "Map Type" : "" : "The type of the map. This is used to determine certain map-specific features and behaviors. For example, on Hideout maps, combat is disabled and players can sell/trade items." =
    [
        0 : "Combat"
        1 : "Hideout"
    ]
]

@PointClass base(Targetname, Angles) studioprop("models/props_lab/eyescanner.mdl") = versus_housing_instance_switcher :
    "Let's players switch into a housing instance when used."
[
    instancetargetname(target_destination) : "Instance Target Name" : "" : "Where the player will be teleported to when using this entity. This should match the targetname of a versus_housing_instance_target entity."
    instancename(string) : "Instance Name" : "" : "Human-readable name for the instance. Like the room type or something, so players know the type of their room."
]

@PointClass base(Targetname, Angles) studioprop("models/editor/playerstart.mdl") = versus_housing_instance_target :
    "Target for housing instance switcher. This is where players will be teleported to when they use a versus_housing_instance_switcher that points to this entity."
[
    instanceid(string) : "Instance ID" : "" : "Unique identifier for the instance. Players in the same instance will be able to see and interact with each other. Set empty to leave instance and go to common area."
    pricescale(float) : "Price Scale" : "1" : "How expensive the room is. This is a scale, so we can easily adjust prices later by setting the base price for rooms and multiplying it by this scale."
]

@PointClass base(Targetname, Angles) studio() = versus_housing_instance_default_entity :
    "Designates the default spawn position for an entity that comes with the housing instance. Players can move this and it will save the new position. This is used for things like chests that come with the housing instance."
[
    instanceid(string) : "Instance ID" : "" : "Unique identifier for the instance this entity belongs to. This should match the instanceid of a versus_housing_instance_target entity."
    entityclass(string) : "Entity Class" : "" : "The class of the entity. This is used to determine what type of entity this is, so we can apply the correct behavior to it. For example, if it's a chest, we want to make it so players can open it and store items in it."
    model(studio) : "World Model" : "" : "The model of the entity. This is used to determine the appearance of the entity. For example, if it's a chest, we want it to look like a chest."
]

@PointClass base(Targetname, Angles) studioprop("models/versus/corkboard001.mdl") = versus_server_corkboard :
    "A corkboard that displays a list of combat servers that players can connect to. The list of servers is configured via the 'versus_combat_servers' ConVar, which should be a comma-separated list of server IPs and ports."
[
    boardtitle(string) : "Board Title" : "" : "The title displayed at the top of the corkboard."
]

@PointClass base(Angles) studio("models/editor/playerstart.mdl") = versus_npc :
    "Entity that represents an NPC in the world"
[
    npcid(string) : "NPC UniqueID" : "" : "Unique ID of the NPC, used to setup appearance and interactions."
]
